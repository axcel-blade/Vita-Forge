# Copy to backend/.env for local NestJS.

PORT=3001
JWT_SECRET=vita-forge-secret-key-change-in-production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Omit or leave blank to keep the in-memory store (no Postgres required).
# Example when Postgres is running: postgresql://vita:vita@localhost:5432/vitaforge
DATABASE_URL=

ANTHROPIC_API_KEY=
